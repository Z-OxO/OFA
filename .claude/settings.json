{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebFetch(domain:api.openfront.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./data/raw/**)",
      "Edit(./data/openfront/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
	"allowedDomains": [
  		"api.openfront.io", "github.com", "codeload.github.com",
  		"raw.githubusercontent.com", "api.github.com", "objects.githubusercontent.com",
  		"openfront.io",
  		"registry.npmjs.org", "pypi.org", "files.pythonhosted.org", "api.anthropic.com"
	]
    },
    "filesystem": {
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv", "~/.npm"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh\"" }
        ]
      }
    ]
  }
}
